@page "/kitchen"
@rendermode InteractiveServer
@inject FoodSprint.Services.CulinaryService Culinary

<PageTitle>Live KDS Rail · CulinaryOS</PageTitle>

<div class="container-fluid px-0">
    <!-- Page Header Ribbon -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle font-mono px-2 py-1">
                    <span class="live-dot live-dot-red me-1"></span>DINNER SERVICE · LIVE
                </span>
                <span class="text-muted small">Terminal: Station 02</span>
            </div>
            <h2 class="fw-bold text-dark mb-1">Live KDS Rail</h2>
            <p class="text-muted small mb-0">12 open tickets across 4 stations</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <!-- Legend Dots -->
            <div class="d-flex align-items-center bg-white px-3 py-1.5 rounded-pill border shadow-sm">
                <span class="d-inline-flex align-items-center small font-mono me-3">
                    <span class="live-dot live-dot-green me-1.5"></span>
                    <span class="text-secondary" style="font-size: 0.78rem;">On target</span>
                </span>
                <span class="d-inline-flex align-items-center small font-mono me-3">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background-color: #F59E0B;" class="me-1.5"></span>
                    <span class="text-secondary" style="font-size: 0.78rem;">Near par</span>
                </span>
                <span class="d-inline-flex align-items-center small font-mono">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background-color: #EF4444;" class="me-1.5"></span>
                    <span class="text-secondary" style="font-size: 0.78rem;">Over par</span>
                </span>
            </div>

            <!-- Stations Filter Dropdown -->
            <select class="form-select form-select-sm fw-semibold" style="min-width: 140px;" @bind="selectedStationFilter">
                <option value="All">All stations</option>
                <option value="Garde Manger">Garde Manger</option>
                <option value="Hot Line">Hot Line</option>
                <option value="Sauté">Sauté</option>
                <option value="Grill">Grill</option>
                <option value="Pastry">Pastry</option>
            </select>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusNotification))
    {
        <div class="alert alert-info alert-dismissible fade show d-flex align-items-center py-2 px-3 mb-3 shadow-sm" role="alert">
            <span class="me-2">📢</span>
            <div class="small fw-semibold">@statusNotification</div>
            <button type="button" class="btn-close btn-close-sm ms-auto" @onclick="() => statusNotification = string.Empty"></button>
        </div>
    }

    <!-- KDS Board Cards Multi-Column Grid -->
    <div class="row g-4 mb-4">
        @foreach (var ticket in DisplayTickets)
        {
            var isAllergenCard = !string.IsNullOrEmpty(ticket.AllergyAlert) && ticket.AllergyAlert != "None";
            var isOverPar = ticket.ElapsedMinutes >= 12;
            var isNearPar = ticket.ElapsedMinutes >= 8 && ticket.ElapsedMinutes < 12;

            <div class="col-xl-4 col-md-6">
                <div class="culinary-card h-100 d-flex flex-column @(isAllergenCard ? "allergen-card" : "") shadow-sm">
                    @if (isAllergenCard)
                    {
                        <!-- Critical Allergen Top Banner -->
                        <div class="allergen-banner">
                            <span class="fs-6">🚨</span>
                            <span>CRITICAL ALLERGEN @ticket.AllergyAlert</span>
                        </div>
                    }

                    <!-- Card Header -->
                    <div class="culinary-card-header d-flex justify-content-between align-items-center py-2.5 px-3">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold fs-5 text-dark">Table @ticket.TableNumber</span>
                                <span class="badge bg-light text-secondary border font-mono">@ticket.Guests Guests</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 mt-1">
                                <span class="badge bg-secondary-subtle text-secondary small font-mono">@ticket.Station</span>
                                @if (ticket.IsRush)
                                {
                                    <span class="badge bg-danger text-white font-mono small">⚡ RUSH</span>
                                }
                            </div>
                        </div>

                        <!-- Elapsed Time Indicator -->
                        <div class="text-end">
                            <span class="badge font-mono px-2 py-1.5 @(isOverPar ? "bg-danger text-white" : isNearPar ? "bg-warning text-dark" : "bg-success text-white")" style="font-size: 0.85rem;">
                                ⏱️ @(!string.IsNullOrEmpty(ticket.ElapsedTimeString) ? ticket.ElapsedTimeString : $"{ticket.ElapsedMinutes:D2}:00")
                            </span>
                            <div class="text-muted font-mono" style="font-size: 0.68rem; margin-top: 2px;">
                                @(isOverPar ? "Exceeding Par" : isNearPar ? "Near Par" : "On Target")
                            </div>
                        </div>
                    </div>

                    <!-- Card Body / Ticket Line Items -->
                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <div class="ticket-course-tag mb-2">
                            <span class="kicker-muted">COURSE: @ticket.ActiveCourse</span>
                        </div>

                        <ul class="list-unstyled mb-4 flex-grow-1">
                            @if (ticket.ItemDetails.Any())
                            {
                                @foreach (var item in ticket.ItemDetails)
                                {
                                    <li class="py-1.5 border-bottom border-light-subtle">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="fw-bold text-dark fs-6 font-mono">@item.Name</span>
                                            @if (!string.IsNullOrEmpty(item.Badge))
                                            {
                                                <span class="badge bg-danger text-white font-mono small px-2 py-0.5" style="font-size: 0.68rem;">
                                                    @item.Badge
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.Note))
                                        {
                                            <div class="small text-danger fw-semibold mt-0.5 ms-2 font-mono" style="font-size: 0.75rem;">
                                                ↳ @item.Note
                                            </div>
                                        }
                                    </li>
                                }
                            }
                            else
                            {
                                @foreach (var item in ticket.Items)
                                {
                                    <li class="py-1.5 border-bottom border-light-subtle d-flex align-items-center justify-content-between">
                                        <span class="fw-bold text-dark fs-6 font-mono">@item</span>
                                        @if (item.Contains("NO PEANUT", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger text-white font-mono small">NO PEANUT</span>
                                        }
                                        else if (item.Contains("ALLERGY", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger text-white font-mono small">ALLERGY</span>
                                        }
                                    </li>
                                }
                            }
                        </ul>

                        <!-- Bottom Action Buttons -->
                        <div class="d-flex gap-2 mt-auto pt-2 border-top">
                            @if (isAllergenCard)
                            {
                                <button class="btn btn-pink w-50 d-flex align-items-center justify-content-center gap-1 shadow-sm" @onclick="() => CallExpo(ticket)">
                                    <span>@(ticket.ExpoCalled ? "Expo Called ✓" : "Call Expo")</span>
                                </button>
                                <button class="btn btn-terracotta w-50 d-flex align-items-center justify-content-center gap-1 shadow-sm" @onclick="() => MarkPlated(ticket)">
                                    <span>Mark Plated</span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-50 d-flex align-items-center justify-content-center gap-1 fw-semibold @(ticket.IsRush ? "active" : "")" @onclick="() => ToggleRush(ticket)">
                                    <span>⚡ Rush</span>
                                </button>
                                <button class="btn btn-terracotta w-50 d-flex align-items-center justify-content-center gap-1 shadow-sm" @onclick="() => MarkPlated(ticket)">
                                    <span>Mark Plated</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Bottom Insight Banner -->
    <div class="service-insight-banner p-3 rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-5">⚡</span>
            <span class="fw-semibold text-dark">
                Service insight: <span class="text-secondary fw-normal">Garde Manger is clearing tickets 1m 12s faster than average.</span>
            </span>
        </div>
        <a href="javascript:void(0)" class="fw-bold text-decoration-none d-flex align-items-center gap-1" style="color: #E05A47;" @onclick="ShowAnalytics">
            <span>View station analytics</span>
            <span>↗</span>
        </a>
    </div>
</div>

@code {
    private string selectedStationFilter = "All";
    private string statusNotification = "";

    private IEnumerable<FoodSprint.Models.KitchenTicket> DisplayTickets
    {
        get
        {
            if (selectedStationFilter == "All")
                return Culinary.ActiveTickets;

            return Culinary.ActiveTickets.Where(t => t.Station.Equals(selectedStationFilter, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ToggleRush(FoodSprint.Models.KitchenTicket ticket)
    {
        ticket.IsRush = !ticket.IsRush;
        statusNotification = ticket.IsRush
            ? $"Table {ticket.TableNumber} expedited as RUSH priority."
            : $"Table {ticket.TableNumber} returned to standard pace.";
    }

    private void CallExpo(FoodSprint.Models.KitchenTicket ticket)
    {
        ticket.ExpoCalled = true;
        statusNotification = $"🚨 Urgent: Expeditor called for Table {ticket.TableNumber} ({ticket.AllergyAlert}).";
    }

    private void MarkPlated(FoodSprint.Models.KitchenTicket ticket)
    {
        ticket.Status = "Plated";
        statusNotification = $"Table {ticket.TableNumber} ({ticket.Station}) marked as PLATED.";
    }

    private void ShowAnalytics()
    {
        statusNotification = "Station analytics loaded: Garde Manger avg 05:22/ticket · Hot Line avg 08:45/ticket · Sauté avg 07:18/ticket.";
    }
}