@page "/kitchen"
@rendermode InteractiveServer
@inject FoodSprint.Services.CulinaryService Culinary

<PageTitle>Live KDS Rail · CulinaryOS</PageTitle>

<div class="screen">
    <!-- Page Heading -->
    <div class="page-heading">
        <div>
            <div class="eyebrow">Dinner service · Live</div>
            <h1>Live KDS Rail</h1>
            <p>12 open tickets across 4 stations</p>
        </div>
        <div class="heading-actions">
            <div class="legend">
                <span class="dot sage"></span> On target
                <span class="dot amber"></span> Near par
                <span class="dot coral"></span> Over par
            </div>
            <button class="button outline-button" type="button" @onclick="ToggleStationFilter">
                All stations <Icon Name="chevron" Size="14" />
            </button>
        </div>
    </div>

    <!-- KDS Rail Grid -->
    <div class="kds-grid">
        @foreach (var ticket in Culinary.ActiveTickets)
        {
            var isCritical = ticket.TableNumber == 7 || (!string.IsNullOrEmpty(ticket.AllergyAlert) && ticket.AllergyAlert != "None");
            var serverName = ticket.TableNumber == 4 ? "Chloe T." : ticket.TableNumber == 7 ? "Marcus L." : "Ana R.";
            var orderNum = ticket.TableNumber == 4 ? "1084" : ticket.TableNumber == 7 ? "1091" : "1097";
            var timerDisplay = !string.IsNullOrEmpty(ticket.ElapsedTimeString) ? ticket.ElapsedTimeString : $"{ticket.ElapsedMinutes:D2}:00";

            <article class="ticket @(isCritical ? "critical-ticket" : "")">
                @if (isCritical)
                {
                    <div class="allergen-banner">
                        <Icon Name="alert" Size="17" />
                        <strong>CRITICAL ALLERGEN</strong>
                        <span>Severe Peanut Anaphylaxis</span>
                    </div>
                }

                <div class="ticket-header">
                    <div>
                        <div class="table-title">Table @ticket.TableNumber</div>
                        <div class="guest-count"><Icon Name="users" Size="14" /> @ticket.Guests guests</div>
                        <div class="server-meta">Server: @serverName &middot; Dine-in #@orderNum</div>
                    </div>
                    <div class="ticket-meta">
                        <span class="station-pill">@ticket.Station</span>
                        <span class="timer-pill @(isCritical ? "late" : "")">
                            @timerDisplay
                            @if (isCritical)
                            {
                                <small>Exceeding Par</small>
                            }
                        </span>
                    </div>
                </div>

                <div class="ticket-items">
                    @if (ticket.TableNumber == 4)
                    {
                        <div class="course-group">
                            <div class="course-header">
                                <span>Course 1 (Apps)</span>
                                <strong>Plated</strong>
                            </div>
                            <div class="order-row">
                                <span class="quantity">2</span>
                                <div class="order-copy">
                                    <div class="order-name">Hamachi Crudo</div>
                                    <div class="modifier">Extra citrus</div>
                                </div>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">Little Gem Salad</div>
                                    <div class="modifier">No scallions</div>
                                </div>
                            </div>
                        </div>

                        <div class="course-group">
                            <div class="course-header">
                                <span>Course 2 (Mains)</span>
                                <strong>Fire</strong>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">Roasted Atlantic Cod</div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (ticket.TableNumber == 7)
                    {
                        <div class="course-group">
                            <div class="course-header">
                                <span>Course 1 (Apps)</span>
                                <strong>Plated</strong>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">
                                        Charred Broccolini
                                        <span class="allergy-chip">ALLERGY</span>
                                    </div>
                                    <div class="modifier">Clean pan &middot; fresh gloves</div>
                                </div>
                            </div>
                        </div>

                        <div class="course-group">
                            <div class="course-header">
                                <span>Course 2 (Mains)</span>
                                <strong>Fire</strong>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">
                                        Roasted Atlantic Cod
                                        <span class="allergy-chip">NO PEANUT</span>
                                    </div>
                                </div>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">Carnaroli Risotto</div>
                                    <div class="modifier">No shared garnish</div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (ticket.TableNumber == 12)
                    {
                        <div class="course-group">
                            <div class="course-header">
                                <span>Course 1 (Apps)</span>
                                <strong>Plated</strong>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">Burrata & Persimmon</div>
                                </div>
                            </div>
                        </div>

                        <div class="course-group">
                            <div class="course-header">
                                <span>Course 2 (Mains)</span>
                                <strong>Fire</strong>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">Dry-Aged Duck</div>
                                    <div class="modifier">Medium rare</div>
                                </div>
                            </div>
                            <div class="order-row">
                                <span class="quantity">1</span>
                                <div class="order-copy">
                                    <div class="order-name">Wild Mushroom Risotto</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="course-group">
                            <div class="course-header">
                                <span>@ticket.ActiveCourse</span>
                                <strong>@ticket.Status</strong>
                            </div>
                            @foreach (var item in ticket.Items)
                            {
                                <div class="order-row">
                                    <span class="quantity">1</span>
                                    <div class="order-copy">
                                        <div class="order-name">@item</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="ticket-actions">
                    <button class="button expedite-button" type="button" @onclick="() => ToggleRush(ticket)">
                        <Icon Name="bolt" Size="15" /> @(ticket.IsRush ? "Expedited" : "Expedite")
                    </button>
                    <button class="button primary-button" type="button" @onclick="() => CompleteTicket(ticket)">
                        <Icon Name="check" Size="16" /> @(isCritical ? "Complete" : "Bump Ticket")
                    </button>
                </div>
            </article>
        }
    </div>

    <!-- Bottom Rail Summary -->
    <div class="rail-summary">
        <div>
            <Icon Name="sparkle" Size="18" />
            <span><strong>Service insight</strong> Garde Manger is clearing tickets 1m 12s faster than average.</span>
        </div>
        <button type="button" @onclick="ViewAnalytics">
            View station analytics <Icon Name="chevron" Size="14" />
        </button>
    </div>
</div>

@code {
    private void ToggleRush(FoodSprint.Models.KitchenTicket ticket)
    {
        ticket.IsRush = !ticket.IsRush;
    }

    private void CompleteTicket(FoodSprint.Models.KitchenTicket ticket)
    {
        ticket.Status = "Plated";
    }

    private void ToggleStationFilter()
    {
    }

    private void ViewAnalytics()
    {
    }
}