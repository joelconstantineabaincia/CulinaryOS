@page "/pantry"
@rendermode InteractiveServer
@inject FoodSprint.Services.CulinaryService Culinary

<PageTitle>Fresh Pantry & Yield Tracker · CulinaryOS</PageTitle>

<div class="screen">
    <!-- Page Heading -->
    <div class="page-heading">
        <div>
            <div class="eyebrow">Inventory · Updated 4 min ago</div>
            <h1>Fresh Pantry & Yield Tracker</h1>
            <p>Monitor par levels, freshness, and purchasing velocity.</p>
        </div>
        <button class="button primary-button" type="button" @onclick="NewPurchaseOrder">
            <Icon Name="plus" Size="16" /> New purchase order
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="sage-pill mb-2" style="width: fit-content; font-size: 11px; padding: 8px 12px; margin-bottom: 10px;">
            <span class="status-dot"></span> @statusMessage
        </div>
    }

    <!-- 4 Top Metric Cards -->
    <div class="metrics-grid">
        <article class="metric-card">
            <div class="metric-icon sage"><Icon Name="trend" Size="17" /></div>
            <div class="metric-copy">
                <span>Total Stock Par</span>
                <strong>$12,450</strong>
                <small class="sage">+4% vs last week</small>
            </div>
        </article>

        <article class="metric-card">
            <div class="metric-icon amber"><Icon Name="clock" Size="17" /></div>
            <div class="metric-copy">
                <span>Spoilage Risk (48h)</span>
                <strong>$420</strong>
                <small class="amber">8 items to review</small>
            </div>
        </article>

        <article class="metric-card">
            <div class="metric-icon coral"><Icon Name="alert" Size="17" /></div>
            <div class="metric-copy">
                <span>Items Below Par</span>
                <strong>3 items</strong>
                <small class="coral">Action recommended</small>
            </div>
        </article>

        <article class="metric-card">
            <div class="metric-icon clay"><Icon Name="sparkle" Size="17" /></div>
            <div class="metric-copy">
                <span>Turnover Velocity</span>
                <strong>3.8x / mo</strong>
                <small class="clay">Healthy inventory</small>
            </div>
        </article>
    </div>

    <!-- Inventory Data Card & Table -->
    <section class="data-card">
        <div class="section-header">
            <div>
                <h2>Ingredient inventory</h2>
                <p>48 tracked ingredients &middot; Sorted by freshness risk</p>
            </div>
            <div class="table-tools">
                <button class="button outline-button" type="button" @onclick="ToggleFilter">
                    <Icon Name="sliders" Size="15" /> Filter
                </button>
                <button class="button outline-button" type="button" @onclick="ToggleStorage">
                    All storage <Icon Name="chevron" Size="13" />
                </button>
            </div>
        </div>

        <div class="inventory-table">
            <div class="table-row table-head">
                <span />
                <span>Ingredient & lot</span>
                <span>Storage location</span>
                <span>Stock level</span>
                <span>Freshness</span>
                <span>Unit cost</span>
                <span />
            </div>

            @foreach (var item in Culinary.PantryStock)
            {
                var sku = GetItemSku(item);
                var isChecked = selectedSkus.Contains(sku);
                var freshState = GetFreshnessState(item);

                <div class="table-row @(isChecked ? "selected" : "")">
                    <input aria-label="Select @item.Name"
                           checked="@isChecked"
                           class="row-checkbox"
                           @onchange="() => ToggleSku(sku)"
                           type="checkbox" />

                    <div class="ingredient">
                        <div class="ingredient-icon"><Icon Name="leaf" Size="17" /></div>
                        <div>
                            <strong>@item.Name</strong>
                            <small>@GetLotDescription(item)</small>
                        </div>
                    </div>

                    <span class="location">@GetLocationDescription(item)</span>

                    <div class="par-cell">
                        <div>
                            <strong>@item.CurrentStock.ToString("0.#") / @item.MinThreshold.ToString("0.#") @item.Unit</strong>
                            <span>@item.ParPercentage%</span>
                        </div>
                        <div class="par-track">
                            <span style="width: @(Math.Clamp(item.ParPercentage, 5, 100))%;"></span>
                            <i aria-label="Minimum par at 40%"></i>
                        </div>
                    </div>

                    <span class="fresh-chip @freshState">
                        <span class="dot"></span> @item.FreshnessBadge
                    </span>

                    <strong class="unit-cost">@item.UnitCost.ToString("C") / @item.Unit</strong>

                    <button class="order-button" type="button" @onclick="() => OrderItem(item)">
                        <Icon Name="plus" Size="14" /> Order
                    </button>
                </div>
            }
        </div>

        <div class="table-footer">
            <span>Showing @Culinary.PantryStock.Count of 48 ingredients</span>
            <button type="button" @onclick="ViewAll">
                View all inventory <Icon Name="chevron" Size="14" />
            </button>
        </div>
    </section>

    <!-- Floating Batch Action Pill -->
    @if (selectedSkus.Count > 0)
    {
        <div class="batch-pill">
            <span>@selectedSkus.Count items selected</span>
            <i></i>
            <button type="button" @onclick="CreateCombinedPO">
                Create Combined PO <Icon Name="chevron" Size="14" />
            </button>
        </div>
    }
</div>

@code {
    private HashSet<string> selectedSkus = new() { "SEA-1048", "PRO-2231" };
    private string statusMessage = "";

    private string GetItemSku(FoodSprint.Models.PantryItem item)
    {
        if (item.Name.Contains("Cod", StringComparison.OrdinalIgnoreCase)) return "SEA-1048";
        if (item.Name.Contains("Tomato", StringComparison.OrdinalIgnoreCase)) return "PRO-2231";
        if (item.Name.Contains("Rice", StringComparison.OrdinalIgnoreCase)) return "DRY-0812";
        if (item.Name.Contains("Microgreens", StringComparison.OrdinalIgnoreCase)) return "PRO-2904";
        return !string.IsNullOrEmpty(item.Sku) ? item.Sku : $"SKU-{item.Id:D3}";
    }

    private string GetLotDescription(FoodSprint.Models.PantryItem item)
    {
        if (item.Name.Contains("Cod", StringComparison.OrdinalIgnoreCase)) return "Lot #9021 · Harbor Fish Co.";
        if (item.Name.Contains("Tomato", StringComparison.OrdinalIgnoreCase)) return "Lot #4418 · Field & Vine";
        if (item.Name.Contains("Rice", StringComparison.OrdinalIgnoreCase)) return "Lot #7714 · Urbani Foods";
        if (item.Name.Contains("Microgreens", StringComparison.OrdinalIgnoreCase)) return "Lot #1172 · City Sprout Farm";
        if (item.Name.Contains("Duck", StringComparison.OrdinalIgnoreCase)) return "Lot #3391 · Hudson Valley";
        if (item.Name.Contains("Cream", StringComparison.OrdinalIgnoreCase)) return "Lot #5512 · Ronnybrook";
        if (item.Name.Contains("Cocoa", StringComparison.OrdinalIgnoreCase)) return "Lot #1204 · Valrhona USA";
        if (item.Name.Contains("Squid", StringComparison.OrdinalIgnoreCase)) return "Lot #8012 · Point Judith";
        return $"Lot #{item.Id + 1000} · Supplier Direct";
    }

    private string GetLocationDescription(FoodSprint.Models.PantryItem item)
    {
        if (item.Name.Contains("Cod", StringComparison.OrdinalIgnoreCase)) return "Walk-in · Shelf B2";
        if (item.Name.Contains("Tomato", StringComparison.OrdinalIgnoreCase)) return "Produce · Rack A1";
        if (item.Name.Contains("Rice", StringComparison.OrdinalIgnoreCase)) return "Dry Store · Bin 14";
        if (item.Name.Contains("Microgreens", StringComparison.OrdinalIgnoreCase)) return "Walk-in · Shelf A3";
        if (item.StorageZone.Contains("Cooler", StringComparison.OrdinalIgnoreCase)) return "Walk-in · Shelf C1";
        if (item.StorageZone.Contains("Dry", StringComparison.OrdinalIgnoreCase)) return "Dry Store · Bin 08";
        return "Freezer · Unit 02";
    }

    private string GetFreshnessState(FoodSprint.Models.PantryItem item)
    {
        if (item.FreshnessBadge.Contains("18h", StringComparison.OrdinalIgnoreCase) ||
            item.FreshnessBadge.Contains("09h", StringComparison.OrdinalIgnoreCase) ||
            item.FreshnessVariant == "danger")
        {
            return "danger";
        }
        if (item.FreshnessBadge.Contains("1d", StringComparison.OrdinalIgnoreCase) ||
            item.FreshnessBadge.Contains("2 day", StringComparison.OrdinalIgnoreCase) ||
            item.FreshnessVariant == "warning")
        {
            return "warn";
        }
        return "good";
    }

    private void ToggleSku(string sku)
    {
        if (selectedSkus.Contains(sku))
        {
            selectedSkus.Remove(sku);
        }
        else
        {
            selectedSkus.Add(sku);
        }
    }

    private void OrderItem(FoodSprint.Models.PantryItem item)
    {
        item.CurrentStock += 5;
        item.ParPercentage = Math.Min(100, item.ParPercentage + 20);
        statusMessage = $"PO Created: +5 {item.Unit} of {item.Name} ordered. Par updated to {item.ParPercentage}%.";
    }

    private void NewPurchaseOrder()
    {
        statusMessage = "Opened new purchase order draft for reviewed items.";
    }

    private void CreateCombinedPO()
    {
        statusMessage = $"Combined Purchase Order generated for {selectedSkus.Count} items.";
        selectedSkus.Clear();
    }

    private void ToggleFilter()
    {
    }

    private void ToggleStorage()
    {
    }

    private void ViewAll()
    {
    }
}