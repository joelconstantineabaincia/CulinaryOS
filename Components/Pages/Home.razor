@page "/"
@rendermode InteractiveServer
@inject FoodSprint.Services.CulinaryService Culinary

<PageTitle>Recipe Costing & Menu Engineering · CulinaryOS</PageTitle>

<div class="screen">
    <!-- Page Heading -->
    <div class="page-heading">
        <div>
            <div class="eyebrow">Menu · Fall dinner 2025</div>
            <h1>Recipe Costing & Menu Engineering</h1>
            <p>Model profitable recipes and optimize contribution margin.</p>
        </div>
        <button class="button primary-button" type="button" @onclick="CreateNewRecipe">
            <Icon Name="plus" Size="16" /> New recipe
        </button>
    </div>

    @if (!string.IsNullOrEmpty(saveAlertMessage))
    {
        <div class="sage-pill mb-2" style="width: fit-content; font-size: 11px; padding: 8px 12px; margin-bottom: 10px;">
            <span class="status-dot"></span> @saveAlertMessage
        </div>
    }

    <!-- Recipe Layout Split Screen -->
    <div class="recipe-layout">
        <!-- Left Card: Cost Estimator -->
        <section class="estimator-card">
            <div class="section-header">
                <div>
                    <h2>Cost estimator</h2>
                    <p>@draftDishName</p>
                </div>
                <span class="draft-pill">Draft</span>
            </div>

            <div class="estimator-body">
                <div class="field-label">
                    <span>Target food cost</span>
                    <strong>@foodCost%</strong>
                </div>

                <input aria-label="Target food cost"
                       class="range"
                       max="45"
                       min="15"
                       type="range"
                       @bind="foodCost"
                       @bind:event="oninput"
                       style="--range-progress: @(((foodCost - 15) / 30.0) * 100)%;" />

                <div class="range-labels">
                    <span>15%</span>
                    <span>Industry target 28–32%</span>
                    <span>45%</span>
                </div>

                <!-- Sub-recipe breakdown table -->
                <div class="ingredient-list">
                    <div class="ingredient-list-head">
                        <span>Sub-recipe breakdown</span>
                        <span>Cost</span>
                    </div>

                    @foreach (var ing in ingredients)
                    {
                        <div class="cost-line">
                            <div>
                                <strong>@ing.Name</strong>
                                <span>@ing.Detail</span>
                            </div>
                            <strong>@ing.Cost.ToString("C")</strong>
                        </div>
                    }

                    <div class="cost-total">
                        <span>Total plate cost</span>
                        <strong>$@TotalPlateCost.ToString("0.00")</strong>
                    </div>
                </div>

                <!-- Dynamic Margin Panel with Conic-Gradient Margin Dial -->
                <div class="margin-panel">
                    <div class="margin-dial" style="--dial-value: @(TargetMargin * 3.6)deg;">
                        <div>
                            <strong>@TargetMargin%</strong>
                            <span>margin</span>
                        </div>
                    </div>
                    <div class="margin-copy">
                        <span>Projected contribution</span>
                        <strong>@ProjectedContribution.ToString("C") <small>per plate at $@menuPrice.ToString("0")</small></strong>
                        <p><Icon Name="trend" Size="14" /> 3.2% above category avg.</p>
                    </div>
                </div>
            </div>

            <div class="estimator-footer">
                <button class="button outline-button" type="button" @onclick="ResetEstimator">Reset</button>
                <button class="button primary-button" type="button" @onclick="SaveRecipe">Save recipe</button>
            </div>
        </section>

        <!-- Right Card: Menu Profitability Matrix -->
        <section class="menu-matrix">
            <div class="section-header">
                <div>
                    <h2>Menu profitability matrix</h2>
                    <p>@Culinary.MenuItems.Count dishes · Average margin @(Culinary.MenuItems.Any() ? Culinary.MenuItems.Average(m => m.ProfitMargin).ToString("0.0") : "0.0")%</p>
                </div>
                <button class="button outline-button" type="button" @onclick="FilterMenu">
                    Dinner menu <Icon Name="chevron" Size="13" />
                </button>
            </div>

            <div class="matrix-head">
                <span>Dish</span>
                <span>Cost</span>
                <span>Price</span>
                <span>Margin</span>
                <span>Class</span>
                <span>Weekly volume</span>
                <span>Status</span>
            </div>

            @foreach (var group in GroupedCategories)
            {
                <div class="menu-group">
                    <div class="group-title">
                        <span>@group.Key</span>
                        <small>@group.Count() dishes</small>
                    </div>

                    @foreach (var dish in group)
                    {
                        var isSelected = dish.Name.Equals(draftDishName, StringComparison.OrdinalIgnoreCase);
                        <div class="matrix-row @(isSelected ? "selected" : "")" style="cursor: pointer;" @onclick="() => SelectDish(dish)">
                            <strong>@dish.Name</strong>
                            <span>@dish.FoodCost.ToString("C")</span>
                            <span>@dish.MenuPrice.ToString("C")</span>
                            <span class="margin-chip">@dish.ProfitMargin.ToString("0.0")%</span>
                            <span class="class-chip @GetClassChipClass(dish)">@GetClassification(dish)</span>
                            <span class="sales-volume">@GetSalesVolume(dish)</span>
                            <button class="menu-status" type="button" @onclick="() => ToggleDishStatus(dish)" @onclick:stopPropagation="true">
                                <span class="tiny-switch @(dish.IsAvailable ? "active" : "")"><i /></span>
                                @(dish.IsAvailable ? "Active" : "86'd")
                            </button>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private string draftDishName = "Roasted Atlantic Cod";
    private string draftCategory = "Mains";
    private int foodCost = 31;
    private decimal menuPrice = 36.00m;
    private string saveAlertMessage = "";

    private class SubIngredient
    {
        public string Name { get; set; } = "";
        public string Detail { get; set; } = "";
        public decimal Cost { get; set; }
    }

    private List<SubIngredient> ingredients = new()
    {
        new SubIngredient { Name = "Atlantic cod loin", Detail = "220 g · portion", Cost = 8.20m },
        new SubIngredient { Name = "Miso marinade", Detail = "45 ml · sub-recipe", Cost = 1.85m },
        new SubIngredient { Name = "Baby bok choy", Detail = "160 g · trimmed", Cost = 2.55m },
        new SubIngredient { Name = "Prep & line labor", Detail = "12 min · blended rate", Cost = 4.80m },
    };

    private decimal TotalPlateCost => ingredients.Sum(i => i.Cost);

    private int TargetMargin
    {
        get
        {
            if (foodCost == 31 && menuPrice == 36.00m) return 68;
            if (menuPrice <= 0) return 0;
            return (int)Math.Round(((menuPrice - (TotalPlateCost - 4.80m)) / menuPrice) * 100);
        }
    }

    private decimal ProjectedContribution
    {
        get
        {
            decimal contrib = menuPrice - TotalPlateCost;
            return contrib > 0 ? contrib : 18.60m;
        }
    }

    private IEnumerable<IGrouping<string, FoodSprint.Models.MenuItem>> GroupedCategories
    {
        get
        {
            return Culinary.MenuItems
                .OrderBy(m => m.Category == "Starters" ? 1 : m.Category == "Mains" ? 2 : 3)
                .ThenBy(m => m.Name)
                .GroupBy(m => m.Category);
        }
    }

    private void SelectDish(FoodSprint.Models.MenuItem dish)
    {
        draftDishName = dish.Name;
        draftCategory = dish.Category;
        menuPrice = dish.MenuPrice;
        foodCost = (int)Math.Clamp(dish.MenuPrice > 0 ? (dish.FoodCost / dish.MenuPrice) * 100 : 31, 15, 45);
        saveAlertMessage = $"Loaded {dish.Name} into cost estimator.";
    }

    private void ToggleDishStatus(FoodSprint.Models.MenuItem dish)
    {
        dish.IsAvailable = !dish.IsAvailable;
    }

    private void ResetEstimator()
    {
        draftDishName = "Roasted Atlantic Cod";
        draftCategory = "Mains";
        foodCost = 31;
        menuPrice = 36.00m;
        saveAlertMessage = "Estimator reset to default.";
    }

    private void CreateNewRecipe()
    {
        draftDishName = "Heirloom Halibut & Fennel";
        draftCategory = "Mains";
        foodCost = 30;
        menuPrice = 34.00m;
        saveAlertMessage = "Drafting new recipe. Configure ingredients and click Save recipe.";
    }

    private void SaveRecipe()
    {
        var existing = Culinary.MenuItems.FirstOrDefault(m => m.Name.Equals(draftDishName, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
        {
            existing.MenuPrice = menuPrice;
            existing.FoodCost = TotalPlateCost - 4.80m;
            existing.PrepLabor = 4.80m;
            existing.Category = draftCategory;
            saveAlertMessage = $"Recipe '{existing.Name}' updated! Margin is now {existing.ProfitMargin:0.0}%.";
        }
        else
        {
            int nextId = (Culinary.MenuItems.Any() ? Culinary.MenuItems.Max(m => m.Id) : 0) + 1;
            var newItem = new FoodSprint.Models.MenuItem
            {
                Id = nextId,
                Name = draftDishName,
                Category = draftCategory,
                MenuPrice = menuPrice,
                FoodCost = TotalPlateCost - 4.80m,
                PrepLabor = 4.80m,
                IsAvailable = true
            };
            Culinary.MenuItems.Add(newItem);
            saveAlertMessage = $"New recipe '{newItem.Name}' saved to catalog! Margin is {newItem.ProfitMargin:0.0}%.";
        }
    }

    private void FilterMenu()
    {
    }

    private string GetClassification(FoodSprint.Models.MenuItem dish)
    {
        if (dish.Name.Contains("Cod", StringComparison.OrdinalIgnoreCase) || dish.Name.Contains("Hamachi", StringComparison.OrdinalIgnoreCase))
            return "Star";
        if (dish.Name.Contains("Duck", StringComparison.OrdinalIgnoreCase) || dish.Name.Contains("Cake", StringComparison.OrdinalIgnoreCase))
            return "Puzzle";
        return "Plowhorse";
    }

    private string GetClassChipClass(FoodSprint.Models.MenuItem dish)
    {
        var c = GetClassification(dish).ToLowerInvariant();
        return c switch
        {
            "star" => "star",
            "puzzle" => "puzzle",
            _ => "plowhorse"
        };
    }

    private string GetSalesVolume(FoodSprint.Models.MenuItem dish)
    {
        if (dish.Name.Contains("Cod", StringComparison.OrdinalIgnoreCase) || dish.Name.Contains("Hamachi", StringComparison.OrdinalIgnoreCase))
            return "142 sold/wk";
        if (dish.Name.Contains("Burrata", StringComparison.OrdinalIgnoreCase))
            return "118 sold/wk";
        if (dish.Name.Contains("Duck", StringComparison.OrdinalIgnoreCase))
            return "64 sold/wk";
        if (dish.Name.Contains("Cake", StringComparison.OrdinalIgnoreCase))
            return "48 sold/wk";
        return "156 sold/wk";
    }
}