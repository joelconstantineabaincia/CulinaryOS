@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<div class="app-shell">
    <NavMenu />
    <div class="main-column">
        <header class="topbar">
            <div class="breadcrumbs">
                <span>CulinaryOS</span>
                <span class="slash">/</span>
                <strong>@PageEyebrow</strong>
            </div>
            <div class="pace">
                <div><Icon Name="clock" Size="15" /> Avg Ticket: <strong>8m 45s</strong></div>
                <span class="sage-pill"><span class="status-dot"></span> Service: On Pace</span>
            </div>
            <div class="top-actions">
                <button class="search-pill" type="button" @onclick="FocusSearch">
                    <Icon Name="search" Size="15" />
                    <span>Quick search</span>
                    <kbd>⌘K</kbd>
                </button>
                <button class="notification-button" aria-label="Notifications, 3 unread" type="button" @onclick="ToggleNotification">
                    <Icon Name="bell" Size="17" />
                    @if (hasUnread)
                    {
                        <span></span>
                    }
                </button>
                <span class="shift-text">Shift</span>
                <button aria-label="Toggle shift"
                        aria-pressed="@onShift"
                        class="switch @(onShift ? "on" : "")"
                        @onclick="() => onShift = !onShift"
                        type="button">
                    <span></span>
                </button>
                <button class="filter-button" type="button" @onclick="ToggleFilters">
                    <Icon Name="sliders" Size="16" /> Quick filters
                </button>
            </div>
        </header>
        <main>
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool onShift = true;
    private bool hasUnread = true;
    private bool showFilters = false;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string PageEyebrow
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
            if (relative.StartsWith("kitchen")) return "Kitchen Display";
            if (relative.StartsWith("pantry")) return "Inventory Control";
            return "Menu Intelligence";
        }
    }

    private void FocusSearch()
    {
    }

    private void ToggleNotification()
    {
        hasUnread = !hasUnread;
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
