@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<div class="page-shell">
    <aside class="sidebar-shell">
        <NavMenu />
    </aside>

    <main class="main-shell">
        <!-- Top Bar -->
        <header class="top-bar-shell px-4 py-2 d-flex justify-content-between align-items-center">
            <!-- Left: Breadcrumb hierarchy -->
            <div class="d-flex align-items-center gap-2">
                <span class="crumb-brand">CulinaryOS</span>
                <span class="crumb-separator">/</span>
                <span class="crumb-current">@CurrentPageContext</span>
            </div>

            <!-- Center / Right: Indicators & Controls -->
            <div class="d-flex align-items-center gap-3">
                <!-- Avg Ticket Counter -->
                <div class="ticket-counter d-flex align-items-center px-2.5 py-1 rounded-2">
                    <span class="ticket-icon me-1.5">⏱️</span>
                    <span class="ticket-label text-muted small me-1">Avg Ticket:</span>
                    <span class="ticket-value font-mono fw-bold small">8m 45s</span>
                </div>

                <!-- Soft Sage Service Pace Pill -->
                <div class="service-pace-pill d-flex align-items-center px-2.5 py-1">
                    <span class="pulse-dot pulse-dot-sage me-1.5"></span>
                    <span class="small fw-semibold">Service: On Pace</span>
                </div>

                <!-- Shift Dropdown -->
                <div class="position-relative">
                    <button class="btn btn-sm btn-outline-warm shift-dropdown-btn d-flex align-items-center gap-1.5" type="button" @onclick="ToggleShiftDropdown">
                        <span>Dinner Service</span>
                        <span class="dropdown-arrow">▾</span>
                    </button>
                    @if (showShiftDropdown)
                    {
                        <div class="dropdown-menu show shadow-sm border position-absolute mt-1 end-0 py-1" style="min-width: 175px; z-index: 1050; border-color: var(--border-subtle);">
                            <button class="dropdown-item small active fw-semibold" @onclick="() => showShiftDropdown = false">Dinner Service (Active)</button>
                            <button class="dropdown-item small" @onclick="() => showShiftDropdown = false">Lunch Rush</button>
                            <button class="dropdown-item small" @onclick="() => showShiftDropdown = false">Late Night / Bar</button>
                        </div>
                    }
                </div>

                <!-- Quick Filters Trigger -->
                <button class="btn btn-sm btn-outline-warm quick-filters-btn d-flex align-items-center gap-1.5" @onclick="ToggleQuickFilters">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    <span>Quick filters</span>
                </button>
            </div>
        </header>

        @if (showQuickFiltersNotice)
        {
            <div class="quick-filters-subbar px-4 py-2 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 small">
                    <span class="fw-semibold text-muted">Quick Filter Presets:</span>
                    <span class="badge bg-light text-dark border">Allergens Only</span>
                    <span class="badge bg-light text-dark border">Tickets > 10m</span>
                    <span class="badge bg-light text-dark border">Margin &lt; 65%</span>
                    <span class="badge bg-light text-dark border">Below Par Only</span>
                </div>
                <button type="button" class="btn-close btn-close-sm small" style="font-size: 0.65rem;" @onclick="() => showQuickFiltersNotice = false"></button>
            </div>
        }

        <article class="content-canvas px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool showShiftDropdown = false;
    private bool showQuickFiltersNotice = false;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string CurrentPageContext
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
            if (relative.StartsWith("kitchen")) return "Live KDS Rail";
            if (relative.StartsWith("pantry")) return "Pantry & Par Levels";
            return "Recipes & Margins";
        }
    }

    private void ToggleShiftDropdown() => showShiftDropdown = !showShiftDropdown;
    private void ToggleQuickFilters() => showQuickFiltersNotice = !showQuickFiltersNotice;

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
