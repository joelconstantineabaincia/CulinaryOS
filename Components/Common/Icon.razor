<svg aria-hidden="true"
     class="icon @Class"
     fill="none"
     height="@Size"
     viewBox="0 0 24 24"
     width="@Size">
    @switch (Name.ToLowerInvariant())
    {
        case "brand":
            <path d="M6.5 7.5c0-2.2 1.8-4 4-4h7v7c0 2.2-1.8 4-4 4h-7v-7Z" />
            <path d="M10.5 14.5v6M7.5 20.5h6" />
            break;
        case "rail":
            <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" />
            break;
        case "pantry":
            <path d="M4 9h16M6 9l1 11h10l1-11M8 5h8l1 4H7l1-4Z" />
            <path d="M10 13h4" />
            break;
        case "recipe":
            <path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4Z" />
            <path d="M8 4v13a3 3 0 0 0 3 3M11 8h5M11 12h5" />
            break;
        case "sliders":
            <path d="M4 7h10M18 7h2M4 17h3M11 17h9" />
            <circle cx="16" cy="7" r="2" />
            <circle cx="9" cy="17" r="2" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;
        case "users":
            <circle cx="9" cy="9" r="3" />
            <path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 7.5a2.5 2.5 0 0 1 0 5M17 15a4 4 0 0 1 3.5 4" />
            break;
        case "chevron":
            <path d="m9 18 6-6-6-6" />
            break;
        case "flame":
            <path d="M13.5 3.5c.8 4-2.5 4.5-1 7.5 1-1.5 2.5-2 3.5-4 2.5 3 3 5.5 2 8.5a6.5 6.5 0 1 1-12-5c.5 2.5 2 3 3 3.5-1-4 1.5-7 4.5-10.5Z" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "leaf":
            <path d="M19.5 4.5C11 4.5 5 8.5 5 14a5.5 5.5 0 0 0 5.5 5.5c5.5 0 9-6 9-15Z" />
            <path d="M5 20c2-5 5-8 10-10" />
            break;
        case "alert":
            <path d="M12 3 2.8 19h18.4L12 3Z" />
            <path d="M12 9v4M12 16.5h.01" />
            break;
        case "trend":
            <path d="m4 16 5-5 4 4 7-8M15 7h5v5" />
            break;
        case "sparkle":
            <path d="M12 3c.5 5 3 7.5 8 8-5 .5-7.5 3-8 8-.5-5-3-7.5-8-8 5-.5 7.5-3 8-8Z" />
            break;
        case "check":
            <path d="m5 12 4 4 10-10" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="m16 16 4 4" />
            break;
        case "bell":
            <path d="M6 9a6 6 0 0 1 12 0c0 7 3 7 3 7H3s3 0 3-7" />
            <path d="M10 20h4" />
            break;
        case "bolt":
            <path d="M13.5 2.5 5.5 13h6l-1 8.5 8-11h-6l1-8Z" />
            break;
        case "trash":
            <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            break;
        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case "edit":
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
            break;
    }
</svg>

@code {
    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 18;

    [Parameter]
    public string Class { get; set; } = "";
}
